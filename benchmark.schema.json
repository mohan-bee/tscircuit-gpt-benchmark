{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohan-bee/pcb-cad-viewer/blob/main/benchmark.schema.json",
  "title": "PCB benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "model", "complexity", "circuit", "prompt", "components", "boardSize", "platforms"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
    "model": { "type": "string", "minLength": 1 },
    "complexity": { "type": "string", "minLength": 1 },
    "circuit": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "components": { "type": "integer", "minimum": 1 },
    "boardSize": { "type": "string", "minLength": 1 },
    "visible": { "type": "boolean" },
    "platforms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "pcb", "schematic", "pcbSource", "schematicSource", "renderer"],
            "properties": {
              "name": { "enum": ["tscircuit", "KiCad"] },
              "circuitJson": { "type": "string", "minLength": 1 },
              "pcb": { "type": "string", "minLength": 1 },
              "pcbLayers": {
                "type": "object",
                "additionalProperties": false,
                "required": ["top", "bottom"],
                "properties": {
                  "top": { "type": "string", "minLength": 1 },
                  "bottom": { "type": "string", "minLength": 1 }
                }
              },
              "schematic": { "type": "string", "minLength": 1 },
              "pcbSource": { "type": "string", "minLength": 1 },
              "schematicSource": { "type": "string", "minLength": 1 },
              "renderer": { "type": "string", "minLength": 1 },
              "activeTime": { "type": "string", "minLength": 1 },
              "timingBreakdown": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["stage", "duration", "elapsed"],
                  "properties": {
                    "stage": { "type": "string", "minLength": 1 },
                    "duration": { "type": "string", "minLength": 1 },
                    "elapsed": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "boardDetails": { "type": "string", "minLength": 1 },
              "boardFeatures": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "enum": ["tscircuit", "KiCad"] },
              "status": { "const": "pending" }
            }
          }
        ]
      }
    }
  }
}
