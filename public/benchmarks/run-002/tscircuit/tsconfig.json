{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["tscircuit"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["*.tsx"]
}
