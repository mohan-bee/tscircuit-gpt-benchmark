{
  "name": "pcb-cad-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.benchmark.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:benchmarks": "node scripts/validate-benchmarks.mjs",
    "benchmark": "node --import tsx scripts/run-benchmark.ts",
    "validate:evaluations": "node --import tsx scripts/validate-evaluations.ts"
  },
  "dependencies": {
    "@tscircuit/pcb-viewer": "^1.11.393",
    "@tscircuit/runframe": "0.0.2623",
    "@tscircuit/schematic-viewer": "^2.0.89",
    "@vitejs/plugin-react": "latest",
    "circuit-json": "0.0.479",
    "lucide-react": "latest",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tscircuit": "0.0.2463",
    "vite": "latest",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "tsx": "4.20.5",
    "typescript": "latest",
    "vitest": "latest"
  }
}
